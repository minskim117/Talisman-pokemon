{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// 배포 주소 앞부분: https://pokemon-talisman.<계정>.workers.dev
	"name": "pokemon-talisman",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-19",
	// public/ 은 정적 자산으로 바로 제공하고, /api/* 만 Worker 가 처리한다
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	// 비밀이 아닌 설정값. OPENAI_API_KEY 는 로컬은 .env, 배포는 `npx wrangler secret put OPENAI_API_KEY`
	"vars": {
		"TEXT_MODEL": "gpt-5.6-terra",
		"IMAGE_MODEL": "gpt-image-2.5-sunburst",
		"IMAGE_SIZE": "1024x1536",
		"IMAGE_QUALITY": "medium"
	},
	// IP별 하루 부적 생성 횟수(A 방식 성공만 센다). 관리자 IP 는 secret ADMIN_IPS (쉼표로 구분)
	"kv_namespaces": [
		{ "binding": "USAGE", "id": "14aa79d0a06043ffb2553a01a87d20bb" }
	],
	// 포켓몬별 A/B 결과 로그(console.log)를 대시보드 Workers Logs 에서 볼 수 있게 한다
	"observability": {
		"enabled": true
	}
}
